+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.padding_records = []
+
+    @contextmanager
+    def context(self):
+        eager = qm.eager_attention_forward
+
+        def aligned(module, q, k, v, attention_mask=None, **kw):
+            if self.skip and getattr(module, 'layer_idx', -1) in original.SKIP and (q.shape[-2] == self.n - 1) and (self.step == 0):
+                assert k.shape[-2] == self.n - 1 and attention_mask is not None
+                kp, vp, mp = pad_dead_key(k, v, attention_mask)
+                out, w = eager(module, q, kp, vp, mp, **kw)
+                if self.audit_enabled:
+                    assert float(w[..., -1].abs().max()) == 0.0
+                if self.audit_enabled:
+                    self.padding_records.append(dict(layer=module.layer_idx, step=0, computed_query_rows=q.shape[-2], computed_KV_projection_rows=k.shape[-2], temporary_zero_key_rows=1, actual_attention_key_rows=kp.shape[-2], persistent_dummy_KV_rows=0, dummy_probability=0.0, extra_QK_AV_flops=4 * q.shape[0] * q.shape[1] * q.shape[-2] * q.shape[-1]))
+                return (out, w[..., :-1])
+            return eager(module, q, k, v, attention_mask, **kw)
+        with patch.object(qm, 'eager_attention_forward', aligned), super().context():
+            yield self
+
+    def audit(self):
+        d = super().audit()
+        d['minimal_repair'] = 'one_dead_zero_key_prefill_L1_L6'
+        d['padding_records'] = self.padding_records
+        d['actual_language_matrix_flops'] = sum((x['flops'] for x in self.shapes)) + sum((x['extra_QK_AV_flops'] for x in self.padding_records))
+        return d
+
+def generate(*args, **kwargs):
+    with patch.object(original, 'Execution', RepairExecution):
+        return original.generate(*args, **kwargs)
